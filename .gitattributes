# Normalise line endings across platforms.
# Windows-only launchers must stay CRLF or cmd.exe can misparse them.
* text=auto

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

*.java text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

*.exe  binary
*.class binary
